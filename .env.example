# Application Settings
PROJECT_NAME="Intelligent File Deduplication System"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security & JWT
SECRET_KEY="super-secret-production-grade-key-change-this-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database Configuration
MYSQL_USER="dedup_user"
MYSQL_PASSWORD="dedup_password_123"
MYSQL_ROOT_PASSWORD="root_password_123"
MYSQL_HOST="localhost"
MYSQL_PORT=3307
MYSQL_DB="file_dedup_db"

# SQLAlchemy Connection URI (Host machine access via mapped port 3307)
DATABASE_URL="mysql+pymysql://dedup_user:dedup_password_123@localhost:3307/file_dedup_db"

# Redis & Celery Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# File Storage Configuration
UPLOAD_DIR="storage/uploads"
MAX_FILE_SIZE_MB=500
CHUNK_SIZE_BYTES=65536